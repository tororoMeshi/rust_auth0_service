# syntax=docker/dockerfile:1.7

# ---- Build (Vite) ----
FROM node:20-bullseye AS builder
WORKDIR /app

COPY package*.json ./
RUN --mount=type=cache,target=/root/.npm \
    if [ -f package-lock.json ]; then npm ci || npm i; else npm i; fi

COPY . .
RUN npm run build

# ---- Runtime (Nginx, static hosting) ----
FROM nginx:1.29-alpine

# 固定UID/GIDで非rootユーザー作成（K8s securityContext と合わせる）
ARG APP_UID=10001
ARG APP_GID=10001
RUN addgroup -g ${APP_GID} -S appgroup \
 && adduser  -u ${APP_UID} -S appuser -G appgroup

# Nginx設定と静的ファイル配置
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

# Nginxが書き込む可能性のあるディレクトリだけ権限付与
RUN mkdir -p /var/cache/nginx /var/run/nginx \
 && chown -R appuser:appgroup /usr/share/nginx/html /var/cache/nginx /var/run /etc/nginx

USER ${APP_UID}:${APP_GID}

EXPOSE 8080
# デフォルトCMDは nginx -g 'daemon off;'
